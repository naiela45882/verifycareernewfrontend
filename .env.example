# Copy to .env for secrets shared across modes (Clerk key)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# API URL is set per mode — do not put VITE_API_URL in .env:
#   npm run dev     → .env.development  → http://localhost:5001
#   npm run build   → .env.production   → https://verifycareer-backend.onrender.com
