# Copy to .env for local secrets (never commit .env)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# API URL is set per mode — do not put VITE_API_URL in .env:
#   npm run dev     → .env.development  → http://localhost:5001
#   npm run build   → .env.production   → https://verifycareer-backend.onrender.com

# ── Vercel (Production) — Project → Settings → Environment Variables ──
# Required for https://verifycareer.vercel.app (or your custom domain):
#
#   VITE_API_URL=https://verifycareer-backend.onrender.com
#   VITE_CLERK_PUBLISHABLE_KEY=pk_live_...   (from Clerk → Production instance)
#
# If VITE_API_URL is missing or set to localhost, the production build will fail.
# After changing env vars, redeploy (Deployments → … → Redeploy).
#
# ── Render (backend) — Environment ──
#
#   FRONTEND_URL=https://verifycareer.vercel.app
#   CLERK_SECRET_KEY=sk_live_...           (match the pk_live_ frontend key)
#   CLERK_PUBLISHABLE_KEY=pk_live_...
#   NODE_ENV=production
#
# Multiple origins (preview + production): comma-separated, no spaces required
#   FRONTEND_URL=https://verifycareer.vercel.app,https://your-preview.vercel.app
